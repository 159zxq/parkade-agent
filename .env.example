# 环境变量模板：复制为 .env 并填入真实值（.env 不提交）
# ══════════════════════════════════════════════════════════════════
#  三个模型独立配置，禁止混用：主脑 / 视觉 / 嵌入 各用自己的一组
#  变量（*_API_KEY / *_BASE_URL / *_MODEL）。换其中任一模型时，
#  只改对应那一块，不影响另外两个。
#  每组都可以指向不同的服务商（只要 OpenAI 兼容接口即可）。
# ══════════════════════════════════════════════════════════════════

# ── 1) 主脑大模型（Agent 对话/推理）─────────────────────────────────
#    备选：DeepSeek → BASE_URL=https://api.deepseek.com，MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── 2) 视觉模型（车牌识图通道二）────────────────────────────────────
#    备选：智谱 → BASE_URL=https://open.bigmodel.cn/api/paas/v4，MODEL=glm-4v-flash
#    备选：qwen-vl-flash（免费额度多）
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# ── 3) 嵌入模型（知识库建库与检索）──────────────────────────────────
#    DashScope text-embedding-v3：单次输入上限约 10 条 → EMBEDDING_BATCH=10
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=10

# ── 服务地址（默认即可）─────────────────────────────────────────────
MOCK_BASE=http://127.0.0.1:8000
