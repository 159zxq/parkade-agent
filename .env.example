# 环境变量模板：复制为 .env 并填入真实 key（.env 不提交）
# 主脑 + 嵌入 + 视觉（阿里 DashScope，一站三用）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus

# 备用视觉通道（智谱 glm-4v-flash；不填则只跑 qwen-vl）——二选一
ZHIPU_API_KEY=

# 视觉通道选择：qwen | zhipu
VISION_PROVIDER=qwen

# 若要换 DeepSeek 做主脑（需另配 base_url 与 key）：
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=

# 服务地址（默认即可）
MOCK_BASE=http://127.0.0.1:8000
